# ---------------------------------------------------------------------------
# Urban Route NZ — environment variables. Copy to .env.local and fill in.
# Never commit real secrets. SUPABASE_SERVICE_ROLE_KEY is server-only.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (production mode). Leave blank to use the local file store. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=enquiry-files
SUPABASE_MEDIA_BUCKET=media

# --- Local development admin (ONLY used when Supabase is not configured) ---
# Refused in production unless ALLOW_LOCAL_ADMIN=true.
LOCAL_ADMIN_EMAIL=admin@urbanroute.test
LOCAL_ADMIN_PASSWORD=change-me-local-only
LOCAL_EDITOR_EMAIL=editor@urbanroute.test
LOCAL_EDITOR_PASSWORD=change-me-editor-only
# 32+ random characters, used to sign local admin sessions
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Email notifications (Resend). Blank = log to server console. ---
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=
ENQUIRY_FROM_EMAIL=
SEND_ACKNOWLEDGEMENT_EMAIL=false

# --- Analytics (optional, Plausible-compatible domain) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
